# ─────────────────────────────────────────────
# 데이터 — 용량 문제로 저장소에 포함하지 않음
# Kaggle에서 받아 datasets/ 아래에 배치할 것
# ─────────────────────────────────────────────
datasets/*
!datasets/README.md
!datasets/.gitkeep

# 중간 산출물
# data/ 는 맨 앞에 /를 붙여 최상위만 가리킨다. 안 붙이면 하위 경로의 같은 이름도
# 전부 잡아서 소스 코드인 src/data/ 까지 무시된다.
/data/
outputs/
results/
checkpoints/
*.csv
*.parquet
*.pkl
*.pickle
*.joblib
*.h5
*.npy
*.npz
*.zip
*.gz
*.7z

# 단, 설정과 소규모 참조 파일은 추적
!config/*.csv
!config/*.yaml
!config/*.yml

# ─────────────────────────────────────────────
# 모델 · 실험 기록
# ─────────────────────────────────────────────
models/*.model
models/*.json
*.pt
*.pth
mlruns/
wandb/
.neptune/
lightning_logs/

# ─────────────────────────────────────────────
# 비밀 정보 — 절대 커밋 금지
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
kaggle.json
*.key
*.pem
secrets/

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 가상환경
.venv/
venv/
env/
ENV/

# 테스트 · 린트 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ─────────────────────────────────────────────
# Jupyter
# ─────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ─────────────────────────────────────────────
# 에디터 · OS
# ─────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# Claude Code — 개인 작업 환경, 저장소에 포함하지 않음
# ─────────────────────────────────────────────
CLAUDE.md
.claude/

# ─────────────────────────────────────────────
# 문서 빌드
# ─────────────────────────────────────────────
_build/
site/